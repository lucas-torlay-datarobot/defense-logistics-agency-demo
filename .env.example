# Existing DataRobot Codespace credentials are used automatically if available.
# Otherwise configure these through Codespace secrets or an untracked .env.
# Use your tenant's endpoint; do not assume app.datarobot.com.
# DATAROBOT_ENDPOINT=https://YOUR-TENANT/api/v2
# DATAROBOT_API_TOKEN=SET_USING_SECRETS

# IDs optional when one matching Use Case and synthetic dataset pair exist.
DLA_USE_CASE_ID=
DLA_DAILY_DATASET_ID=
DLA_ORDERS_DATASET_ID=

# Required for --deploy to a chosen prediction environment (e.g. Serverless).
# If blank, deployment only auto-selects when exactly one dedicated server exists.
DLA_PREDICTION_ENVIRONMENT_ID=
# Written into artifacts/prediction/<run>/runtime.env after deployment.
DLA_SHORTAGE_DEPLOYMENT_ID=

# React app and natural-language agent (distinct from the shortage classifier).
# Use a chat-capable LLM deployment; credentials above stay in the Python backend.
DLA_LLM_DEPLOYMENT_ID=
DLA_LLM_MODEL=datarobot-deployed-llm
# Random application-only secret, minimum 24 characters. Enter THIS in the browser.
DLA_APP_ACCESS_TOKEN=
# Default: artifacts/app. Keep on persistent Codespace storage.
# DLA_APP_DATA_DIR=/home/notebooks/storage/defense-logistics-agency-demo/artifacts/app

# Reference document retrieval (separate from the existing chat LLM deployment).
DLA_RAG_VECTOR_DATABASE_ID=6ac695306e7d24fb54aba935
DLA_RAG_VECTOR_DATABASE_NAME=DLA_Supply_Chain_Processes
# Set by scripts/configure_rag.py after deploying that vector database.
DLA_RAG_DEPLOYMENT_ID=
